<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\build\Package.props" />
  <PropertyGroup>
    <AssemblyName>LokiBulkDataProcessor</AssemblyName>
    <PackageId>LokiBulkDataProcessor</PackageId>
    <RootNamespace>Loki.BulkDataProcessor</RootNamespace>
    <Summary>
      Ultra-fast bulk insert library for .NET with Web API-safe multi-execution support. Handles models, DataTables, IDataReaders, JSON, logging, and mapping.
    </Summary>
    <Description>
      Loki Bulk Data Processor is a high-performance .NET library for fast, scalable bulk data ingestion using SQL Server's Bulk Copy engine.
      Now safe for repeated execution in ASP.NET Core Web APIs (v7.0+). Supports saving from model collections, DataTables, IDataReaders, and JSON streams.
      Ideal for ETL workflows, demo environments, and real-time processing. Includes mapping, structured logging (v6+), and flexible dependency injection.

      For tutorials and demos, visit the Loki Software YouTube channel: https://www.youtube.com/channel/UCZSEs5w0PEySBdb9uFE19FQ/playlists
    </Description>
    <PackageTags>
      loki bulk data processor sql sqlserver bulk-copy data-import datareader datatable json-stream structured-logging etl aspnetcore dependency-injection high-performance csharp stephen-rebner
    </PackageTags>
    <PackageReleaseNotes><![CDATA[
        9.0.0 (in progress): Testcontainers.MsSql is no longer a dependency of the library package, so it and its Docker client tree no longer flow to consumers (#17). The driver is now Microsoft.Data.SqlClient 6.1.8 instead of the deprecated System.Data.SqlClient, so EF Core transactions can be passed to IBulkProcessor.Transaction; Encrypt=true is the new default and System.Data.SqlClient transactions are rejected with an ArgumentException (#14). Microsoft.Data.SqlClient brings its own dependencies (Azure.Identity, Microsoft.Identity.Client, SNI runtime) for Entra ID authentication. The mapping API, IBulkProcessor and LokiLoggingOptions moved to the new LokiBulkDataProcessor.Core package (same namespaces, type forwarders kept); the empty public AssemblyInfo class is removed and the assembly version is now 9.0.0.0. Models with get-only properties no longer throw NullReferenceException; those properties are skipped and not saved (#19). This package is now the SQL Server provider over the shared Core pipeline: inject IBulkProcessorFactory or use AddLokiBulkDataProcessor(options).AddSqlServer(); the AddLokiBulkDataProcessor(connectionString, ...) registration still works and gives each DI scope its own processor and settings (#11). A failed copy no longer rolls back your transaction (#12), Loki's connection and transaction are disposed on failure (#13), wrapped exceptions keep the SqlException as InnerException (#15), and DataMapping lookup follows one rule (#16). IBulkProcessor.ConnectionString and WithConnectionString are removed, SaveAsync takes an optional CancellationToken, BulkProcessor is internal, and the Commands, Context and InternalDbOperations types are removed. Loki no longer registers an app-wide ILoggerFactory or console logging. See the README "Upgrade Guide".
]]></PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Repository\**" />
    <EmbeddedResource Remove="Repository\**" />
    <None Remove="Repository\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LokiBulkDataProcessor.Core\LokiBulkDataProcessor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- FastMember, logging and DI abstractions come from LokiBulkDataProcessor.Core. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.8" />
  </ItemGroup>
  <!-- Pack the dependency on LokiBulkDataProcessor.Core as [this version, next major), e.g. [9.0.0, 10.0.0).
       A ProjectReference otherwise packs as an open-ended ">= 9.0.0". This assembly uses only Core's public API
       (the provider SPI, no InternalsVisibleTo), so any 9.x Core is compatible, but 10.0 may break the SPI. -->
  <Target Name="PinCoreDependencyVersion" AfterTargets="_GetProjectReferenceVersions">
    <PropertyGroup>
      <_LokiNextMajorVersion>$([MSBuild]::Add($(Version.Split('.')[0]), 1)).0.0</_LokiNextMajorVersion>
    </PropertyGroup>
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'LokiBulkDataProcessor.Core'">
        <ProjectVersion>[$(Version), $(_LokiNextMajorVersion))</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="LokiBulkDataProcessor.UnitTests" />
    <InternalsVisibleTo Include="LokiBulkDataProcessor.IntegrationTests" />
  </ItemGroup>
</Project>