<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\build\Package.props" />
  <PropertyGroup>
    <AssemblyName>LokiBulkDataProcessor.Oracle</AssemblyName>
    <PackageId>LokiBulkDataProcessor.Oracle</PackageId>
    <RootNamespace>Loki.BulkDataProcessor.Oracle</RootNamespace>
    <Title>Loki Bulk Data Processor for Oracle</Title>
    <Description>Oracle (19c+) provider for Loki Bulk Data Processor on Oracle.ManagedDataAccess.Core: array-bound INSERT that enforces constraints, fires triggers and joins your transaction, or opt-in OracleBulkCopy direct path for staging tables only (no foreign key enforcement). Register it with AddLokiBulkDataProcessor(...).AddOracle().</Description>
    <PackageTags>loki bulk-copy bulk-insert oracle odp.net array-binding direct-path etl datareader datatable json</PackageTags>
    <PackageReleaseNotes><![CDATA[
        9.0.0: new package, the Oracle (19c and later) provider for LokiBulkDataProcessor.Core: AddLokiBulkDataProcessor(options).AddOracle(), then IBulkProcessorFactory.Create(OracleProvider.Name, connectionString). Rows are written with an array-bound INSERT in chunks of BatchSize rows (0 means 5000), each chunk all-or-nothing, inside Loki's or your transaction; constraints are enforced and triggers fire. Destination names are validated and quoted (OracleIdentifierResolution.Unquoted folds them to upper case; CatalogLookup matches quoted mixed-case names through ALL_TAB_COLUMNS). Booleans bind as NUMBER 1/0 by default (OracleBooleanBinding). Errors have fixed, data-free messages with the ORA code and the OracleException as InnerException. Opt-in OracleWriteMode.DirectPath (OracleBulkCopy) is for bulk loads into STAGING TABLES ONLY: register it under its own name and never let untrusted input choose its destination. It is faster on indexed tables but synchronous, blocks other sessions' queries on the table until the transaction ends, does not enforce foreign keys, refuses tables with triggers, allows one load per transaction, and does not detect duplicate keys (the key index becomes UNUSABLE at commit). See the README sections Oracle, Oracle direct path and Repairing an UNUSABLE index.
]]></PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LokiBulkDataProcessor.Core\LokiBulkDataProcessor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- FastMember, logging and DI abstractions come from LokiBulkDataProcessor.Core. -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <!-- Security pin: Oracle.ManagedDataAccess.Core 23.26.400 depends on System.Security.Cryptography.Pkcs 8.0.1, which has
         known High (GHSA-846f-f764-76mx) and Moderate (GHSA-2fmv-rv2c-59x7) advisories. This raises it to the patched .NET 10
         servicing line for every consumer. Drop the pin once the driver depends on a patched version itself. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
  <!-- Pack the dependency on LokiBulkDataProcessor.Core as [this version, next major), e.g. [9.0.0, 10.0.0).
       A ProjectReference otherwise packs as an open-ended ">= 9.0.0". This assembly uses only Core's public API
       (the provider SPI, no InternalsVisibleTo), so any 9.x Core is compatible, but 10.0 may break the SPI. -->
  <Target Name="PinCoreDependencyVersion" AfterTargets="_GetProjectReferenceVersions">
    <PropertyGroup>
      <_LokiNextMajorVersion>$([MSBuild]::Add($(Version.Split('.')[0]), 1)).0.0</_LokiNextMajorVersion>
    </PropertyGroup>
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'LokiBulkDataProcessor.Core'">
        <ProjectVersion>[$(Version), $(_LokiNextMajorVersion))</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="LokiBulkDataProcessor.UnitTests" />
  </ItemGroup>
</Project>
