<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\build\Package.props" />
  <PropertyGroup>
    <AssemblyName>LokiBulkDataProcessor.Core</AssemblyName>
    <PackageId>LokiBulkDataProcessor.Core</PackageId>
    <RootNamespace>Loki.BulkDataProcessor</RootNamespace>
    <Description>Provider-neutral core of Loki Bulk Data Processor: mappings, JSON reader, pipeline and provider SPI. Install a provider package (LokiBulkDataProcessor for SQL Server, LokiBulkDataProcessor.Oracle).</Description>
    <PackageTags>loki bulk-copy bulk-insert etl datareader datatable json mapping</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Step 3: the SQL Server provider still uses Core internals (ReflectionUtils, argument guards,
         MappingInfo, DefaultConfigValues). Step 4 replaces this with the public provider SPI. -->
    <InternalsVisibleTo Include="LokiBulkDataProcessor" />
    <InternalsVisibleTo Include="LokiBulkDataProcessor.UnitTests" />
    <InternalsVisibleTo Include="LokiBulkDataProcessor.IntegrationTests" />
  </ItemGroup>
</Project>
