{
  // No connection strings or passwords here. Set them per environment: user secrets or appsettings.Development.json for
  // local development, environment variables (ConnectionStrings__SqlServer, ConnectionStrings__Oracle) or a secret store
  // elsewhere. A blank value means the engine is not configured (its endpoints answer 503).
  "ConnectionStrings": {
    "SqlServer": "",
    "Oracle": ""
  },
  "Samples": {
    // Applies the EF Core migrations to the SQL Server database at startup. Honoured in the Development environment only.
    "ApplyMigrationsOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      // EF Core logs a failed SaveChanges / command at Error WITH the exception, whose driver message can quote row values
      // (for example a duplicate key). SampleExceptionHandler logs the exception types instead, so these are silenced.
      "Microsoft.EntityFrameworkCore.Update": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Loki.BulkDataProcessor": "Information"
    }
  },
  "AllowedHosts": "*"
}
