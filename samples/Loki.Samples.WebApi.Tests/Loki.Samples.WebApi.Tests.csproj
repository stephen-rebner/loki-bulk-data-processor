<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the WebApi sample's own logic (engine choice, table allow-list, error mapping). No database, no web host.
       Kept apart from LokiBulkDataProcessor.UnitTests so the library tests never reference ASP.NET Core. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="6.7.0" />
    <PackageReference Include="Moq" Version="4.18.1" />
    <PackageReference Include="nunit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.2.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Loki.Samples.WebApi\Loki.Samples.WebApi.csproj" />
  </ItemGroup>
</Project>
