{
  // No connection strings or passwords here: use appsettings.Development.json (the docker-compose databases), user secrets,
  // or ConnectionStrings__SqlServer / ConnectionStrings__Oracle environment variables. A blank value skips that engine
  // when --engine is "all".
  "ConnectionStrings": {
    "SqlServer": "",
    "Oracle": ""
  },
  // Defaults for the command-line options --rows, --engine (sqlserver | oracle | all) and --runs.
  "Benchmark": {
    "Rows": 10000,
    "Engine": "all",
    "Runs": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  }
}
