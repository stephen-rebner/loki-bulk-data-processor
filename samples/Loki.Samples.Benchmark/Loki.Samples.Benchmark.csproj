<Project Sdk="Microsoft.NET.Sdk">
  <!-- A sample, not a package: it builds against the libraries' current code (ProjectReference) and is never packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Loki.Samples.Benchmark</RootNamespace>
    <!-- `dotnet user-secrets set "ConnectionStrings:SqlServer" "..."` (Development only). -->
    <UserSecretsId>loki-samples-benchmark</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <!-- Oracle's EF Core provider for EF Core 10; it uses the same ODP.NET (23.26.400) as LokiBulkDataProcessor.Oracle. -->
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26400" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\LokiBulkDataProcessor\LokiBulkDataProcessor.csproj" />
    <ProjectReference Include="..\..\LokiBulkDataProcessor.Oracle\LokiBulkDataProcessor.Oracle.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
