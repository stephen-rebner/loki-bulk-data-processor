# Copy to samples/.env (git-ignored) to override the local-development passwords in docker-compose.yml.
# If you change them, set the samples' connection strings to match (see samples/README.md).
# SQL Server needs 8+ characters with three of: upper case, lower case, digits, symbols.
LOKI_SAMPLES_SQLSERVER_PASSWORD=
LOKI_SAMPLES_ORACLE_SYS_PASSWORD=
LOKI_SAMPLES_ORACLE_PASSWORD=
