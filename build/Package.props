<Project>
  <!-- Pack metadata shared by every published Loki package. Import from a library csproj. -->
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>Loki Bulk Data Processor</Title>
    <!-- The README on GitHub is the 9.x documentation. -->
    <PackageProjectUrl>https://github.com/stephen-rebner/loki-bulk-data-processor#readme</PackageProjectUrl>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Ship the XML docs in every package so consumers get IntelliSense for the public API. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\LokiBulkDataProcessor\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
